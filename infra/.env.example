COMPOSE_PROFILES=prod
MONGO_USER=acsadmin
MONGO_PASS=CHANGE_ME
GENIEACS_UI_JWT_SECRET=CHANGE_ME
JWT_SECRET=CHANGE_ME
API_DOMAIN=tr069-api.thediv.in
ACS_DOMAIN=acs.thediv.in
ACME_EMAIL=info@thediv.in
ADMIN_EMAIL=info@thediv.in
ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS
CWMP_USER=acs-cpe
CWMP_PASS=CHANGE_ME_ALNUM_16_PLUS
SIM_SERIAL_OFFSET=1
BACKUP_DIR=/opt/acs/backups
BACKUP_KEEP_DAYS=3
BACKUP_RSYNC_TARGET=
BACKUP_RCLONE_TARGET=gdrive-crypt:
BACKUP_REMOTE_KEEP_DAYS=90
UPLOAD_TEST_BYTES=10485760
# Security (Batch 7)
# 2FA is required for these roles; empty = optional for everyone
MFA_REQUIRED_ROLES=noc,admin
# Encrypts stored 2FA secrets (32+ random chars). Set before anyone enrols; changing it invalidates enrolments
MFA_ENC_KEY=
# Extra permissions, e.g. agent:diagnostics.run,agent:device.refresh
PERMS_GRANT=
# cwmp.auth OUI allow-list (comma-separated, 6 hex); apply with scripts/setCwmpAuth.js
CWMP_OUIS=
