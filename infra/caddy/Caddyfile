{
	email {$ACME_EMAIL}
}

(acs) {
	handle /speedtest/upload/* {
		request_body {
			max_size 200MB
		}
		reverse_proxy api:4000
	}
	handle /fw/* {
		uri strip_prefix /fw
		reverse_proxy genieacs-fs:7567
	}
	handle /speedtest/* {
		uri strip_prefix /speedtest
		root * /srv/speedtest
		file_server
	}
	handle {
		reverse_proxy genieacs-cwmp:7547 {
			header_up Forwarded "for=\"{remote_host}\";proto={scheme}"
			transport http {
				keepalive off
			}
		}
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy dashboard:3000
	}
}

{$ACS_DOMAIN} {
	import acs
}

http://{$ACS_DOMAIN} {
	import acs
}
